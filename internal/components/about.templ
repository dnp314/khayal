package components

templ AboutPage() {
	@Layout("Khayal") {
		<main class="about-container">
			<h1>Khayal</h1>
			<p>
				Khayal is a time travelling journal. Ask yourself a question,
				write down your thoughts, and revisit them when enough time has
				passed.
			</p>
			<div class="auth-links">
				<a href="/login">Log in</a>
				<a href="/register">Sign up</a>
			</div>
		</main>
	}
}
