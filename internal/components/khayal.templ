package components

import "github.com/dnp314/khayal/internal/entities"
import "fmt"
import "time"

templ Khayals(khayals []entities.Khayal) {

	<div id="khayal-list">
		for _, khayal := range khayals {
			<div>
				@Khayal(khayal)
			</div>
		}
	</div>
	}

templ CreateKhayal(questionID int) {
	<form
	class="khayal-form"
	hx-post={ fmt.Sprintf("/questions/%d/khayals", questionID) }
	hx-target="#khayal-list"
	hx-swap="outerHTML"
	hx-on::before-request="if (!this.khayal.value.trim()) event.preventDefault()"
	hx-on::after-request="if (event.detail.successful) { this.remove(); } else { this.reset(); growTextarea(this.khayal); syncKhayalReturn(this); }"
	>
		<textarea
			id="khayal"
			name="khayal"
			rows="1"
			placeholder="Your Opinions"
			onkeydown="if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) { event.preventDefault(); this.form.requestSubmit(); }"
		></textarea>

		<fieldset class="khayal-schedule">
			<legend class="khayal-schedule__legend">Bring this back</legend>

			<div class="khayal-schedule__modes">
				<label class="khayal-schedule__option">
					<input type="radio" name="return_mode" value="random" checked/>
					<span>Random time</span>
				</label>
				<label class="khayal-schedule__option">
					<input type="radio" name="return_mode" value="gap"/>
					<span>After a gap</span>
				</label>
				<label class="khayal-schedule__option">
					<input type="radio" name="return_mode" value="date"/>
					<span>On a date</span>
				</label>
			</div>

			<div class="khayal-schedule__details">
				<label class="khayal-schedule__field" data-return-field="gap" hidden>
					<span>Gap</span>
					<select name="return_gap" disabled>
						<option value="1w">1 week</option>
						<option value="1m">1 month</option>
						<option value="2m" selected>2 months</option>
						<option value="6m">6 months</option>
						<option value="1y">1 year</option>
					</select>
				</label>
				<label class="khayal-schedule__field" data-return-field="date" data-return-required="true" hidden>
					<span>Date &amp; time</span>
					<input
						type="datetime-local"
						name="return_date"
						min={ time.Now().Format("2006-01-02T15:04") }
						disabled
					/>
				</label>
			</div>
		</fieldset>

		<button type="submit">Answer</button>
	</form>
}


templ Khayal(khayal entities.Khayal) {
	<article class="khayal-card">
		<div class="khayal-card__content">
			<p class="khayal-card__text">
				{ khayal.Khayal }
			</p>

			<time class="khayal-card__date">
				{ khayal.CreatedAt.Format("2 Jan 2006, 3:04 PM") }
			</time>
		</div>
	</article>
}
