package components

import "fmt"

templ Layout(title string) {
	@pageLayout(title, 0) {
		{ children... }
	}
}

templ LayoutWithUser(title string, userID int) {
	@pageLayout(title, userID) {
		{ children... }
	}
}

templ pageLayout(title string, userID int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			<title>{ title }</title>
			<script src="/static/js/htmx.min.js"></script>
			<script type="module" src="/static/js/app.js"></script>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body data-user-id={ fmt.Sprintf("%d", userID) }>
			{ children... }
		</body>
	</html>
}
