package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			<title>{ title }</title>

			<script src="/static/js/htmx.min.js"></script>
			<script>
			  function growTextarea(el) {
			    const cs = getComputedStyle(el);
			    const min = parseFloat(cs.minHeight) || 0;
			    const max = parseFloat(cs.maxHeight) || Infinity;
			    const start = el.offsetHeight;
			    el.style.height = 'auto';
			    const end = Math.max(min, Math.min(el.scrollHeight + 2, max));
			    el.style.height = end + 'px';
			    if (start !== end) {
			      el.animate(
			        [{ height: start + 'px' }, { height: end + 'px' }],
			        { duration: 120, easing: 'ease-out' }
			      );
			    }
			  }
			  document.addEventListener('input', (e) => {
			    if (e.target.matches('form textarea')) growTextarea(e.target);
			  });

			  function syncKhayalReturn(form) {
			    if (!form) return;
			    const selected = form.querySelector('input[name="return_mode"]:checked');
			    const mode = selected ? selected.value : 'random';
			    form.querySelectorAll('[data-return-field]').forEach((field) => {
			      const active = field.dataset.returnField === mode;
			      field.hidden = !active;
			      field.querySelectorAll('select, input').forEach((control) => {
			        control.disabled = !active;
			        if (field.dataset.returnRequired === 'true') {
			          control.required = active;
			        }
			      });
			    });
			  }

			  document.addEventListener('change', (e) => {
			    if (e.target.matches('form.khayal-form input[name="return_mode"]')) {
			      syncKhayalReturn(e.target.form);
			    }
			  });

			  function fitKhayalPreviews() {
			    document.querySelectorAll('[data-khayal-preview]').forEach((el) => {
			      const full = (el.dataset.fullText || '').replace(/\s+/g, ' ').trim();
			      el.textContent = full;

			      const available = el.clientWidth;
			      if (!full || !available || el.scrollWidth <= available) return;

			      const words = full.split(' ');
			      const suffix = '..';
			      let low = 0;
			      let high = words.length;
			      let best = 0;

			      while (low <= high) {
			        const mid = Math.floor((low + high) / 2);
			        el.textContent = words.slice(0, mid).join(' ') + suffix;
			        if (el.scrollWidth <= available) {
			          best = mid;
			          low = mid + 1;
			        } else {
			          high = mid - 1;
			        }
			      }

			      const preview = words.slice(0, best).join(' ');
			      el.textContent = preview ? preview + suffix : suffix;
			    });
			  }

			  let khayalFitFrame = 0;
			  window.addEventListener('resize', () => {
			    cancelAnimationFrame(khayalFitFrame);
			    khayalFitFrame = requestAnimationFrame(fitKhayalPreviews);
			  });
			  document.addEventListener('htmx:afterSwap', fitKhayalPreviews);

			  document.addEventListener('DOMContentLoaded', () => {
			    document.querySelectorAll('form.khayal-form').forEach(syncKhayalReturn);
			    fitKhayalPreviews();
			  });
			</script>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>

		<body>
			{ children... }
		</body>
	</html>
}
