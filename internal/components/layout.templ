package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			<title>{ title }</title>

			<script src="/static/js/htmx.min.js"></script>

			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>

		<body>
			{ children... }
		</body>
	</html>
}
