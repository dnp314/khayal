package components

import (
	"fmt"

	"github.com/dnp314/khayal/internal/entities"
)

templ CreateQuestion(userID int, placeholder string) {
	<form
		hx-post="/questions"
		hx-target="#question-list"
		hx-swap="outerHTML"
		data-encrypt="question"
		data-user-id={ fmt.Sprintf("%d", userID) }
	>
		<textarea
			id="question"
			rows="1"
			placeholder={ placeholder }
			data-enter-submit
		></textarea>
		<button type="submit">Ask</button>
	</form>
}

templ QuestionTitle(question entities.Question) {
	<h1
		data-ciphertext={ b64(question.QuestionCiphertext) }
		data-aad={ fmt.Sprintf("khayal:v1:question:%d:%s", question.UserID, question.ClientID) }
		data-cipher-field="question"
	>[encrypted]</h1>
}

templ Question(question entities.Question, khayals []entities.Khayal) {
	@QuestionTitle(question)
	@CreateKhayal(question.ID, question.UserID)
	@Khayals(khayals)
}

templ QuestionPage(question entities.Question, khayals []entities.Khayal) {
	@LayoutWithUser("Khayal", question.UserID) {
		@QuestionTitle(question)
		@CreateKhayal(question.ID, question.UserID)
		@Khayals(khayals)
	}
}

templ Questions(questions []entities.Question) {
	<div
		id="question-list"
		hx-get="/questions"
		hx-trigger="every 10s"
		hx-target="#question-list"
		hx-swap-oob="true"
	>
		for _, question := range questions {
			<div>
				<a
					href={ fmt.Sprintf("/questions/%d", question.ID) }
					data-ciphertext={ b64(question.QuestionCiphertext) }
					data-aad={ fmt.Sprintf("khayal:v1:question:%d:%s", question.UserID, question.ClientID) }
					data-cipher-field="question"
				>[encrypted]</a>
			</div>
		}
	</div>
}
